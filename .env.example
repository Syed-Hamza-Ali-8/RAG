# Copy to .env and fill in. .env is gitignored; never commit secrets.

# --- Postgres (used by docker compose AND the app) ---
POSTGRES_USER=gateway
# Any strong local password.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gateway
# Host the app connects to; localhost when running the app on the WSL host.
POSTGRES_HOST=localhost
# Host port published by docker compose (container port is always 5432).
POSTGRES_HOST_PORT=5432

# --- Redis (ARQ background jobs, used from Phase 5) ---
# Host port published by docker compose: 6380, NOT the Redis default 6379, because another
# local project already binds 6379 on the dev machine. Clients connect to localhost:6380.
REDIS_HOST_PORT=6380

# --- Embeddings (local, fastembed) ---
# Must output EMBEDDING_DIM-sized vectors matching chunks.embedding in migrations/001_init.sql;
# the app refuses to start on a mismatch.
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Where ONNX weights are cached. Keep it on the Linux filesystem (not /mnt/*) for speed.
EMBEDDING_CACHE_DIR=/home/YOUR_USER/.cache/gateway/fastembed
# Texts per embedding batch.
EMBEDDING_BATCH_SIZE=32

# --- Chunking (tokens, counted with the embedding model's tokenizer) ---
CHUNK_TARGET_TOKENS=384
# Hard max; must stay below the model's max sequence length (512 for bge-small).
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=64

# --- Auth (Phase 3) ---
# HS256 signing secret for access tokens. Long and random; never commit the real value.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime, minutes.
JWT_TTL_MINUTES=60
# DEV ONLY (correction H): enables POST /v1/auth/token, which issues a token for a seeded user from
# tenant slug + email with no password. Never enable in production; a real deployment uses the
# client's identity provider.
AUTH_DEV_ISSUER_ENABLED=true

# --- Retrieval ---
# Chunks passed to the LLM per query.
RETRIEVAL_TOP_K=6

# --- LLM ---
# Which tier serves queries: small | large | local. Explicit choice; never switched at runtime.
LLM_TIER=small
# Phase 1: both small and large are Groq models (CLAUDE.md correction Q).
LLM_SMALL_BASE_URL=https://api.groq.com/openai/v1
LLM_SMALL_API_KEY=
# Filled by `uv run python scripts/resolve_models.py --small <id>`; never hand-typed.
LLM_SMALL_MODEL_ID=
LLM_LARGE_BASE_URL=https://api.groq.com/openai/v1
LLM_LARGE_API_KEY=
# Filled by `uv run python scripts/resolve_models.py --large <id>`.
LLM_LARGE_MODEL_ID=
# Optional local Ollama tier (LLM_TIER=local). Ollama ignores the key but the SDK needs one.
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL_ID=
# Per-request timeout, seconds.
LLM_TIMEOUT_S=60
# Attempts on 429/5xx before RateLimitExhausted / LLMUnavailable.
LLM_MAX_ATTEMPTS=5
# Exponential backoff base and cap, seconds (jittered).
LLM_BACKOFF_BASE_S=1.0
LLM_BACKOFF_MAX_S=30.0
# Network failures (connection errors, timeouts) have their own budget and wider backoff:
# 8 attempts, 2 s doubling to a 30 s cap (jittered), about two minutes of waiting in all.
LLM_NETWORK_MAX_ATTEMPTS=8
LLM_NETWORK_BACKOFF_BASE_S=2.0
LLM_NETWORK_BACKOFF_MAX_S=30.0
# A completion that hits this limit raises TruncatedCompletion (never a refusal). 700 truncated q052 in Phase 3.
LLM_MAX_COMPLETION_TOKENS=1000
LLM_TEMPERATURE=0.0

# --- Eval / benchmarks ---
# Pause between requests in eval and latency runs, to stay under free-tier rate limits.
# 30000: measured clean twice (0 retries in 20) with ~2.3k-token prompts against Groq's 8,000
# tokens-per-minute limit. 20000 (3 requests/min) sits at that limit: it ran clean once and
# stalled once on repeated 429s.
EVAL_REQUEST_DELAY_MS=30000
# LLM-as-judge tier for eval runs only (small | large | local). A different, larger model than
# the generator avoids self-grading. Explicit choice; never switched at runtime.
EVAL_JUDGE_TIER=large
# Completion budget for each judge call (gpt-oss models spend part of it on reasoning).
EVAL_JUDGE_MAX_COMPLETION_TOKENS=1500
# Provider's per-model daily token cap (Groq free tier: 200,000 tokens/day per model, rolling 24 h,
# not reported in headers). The eval pre-flight check refuses runs that would exceed it.
LLM_DAILY_TOKEN_LIMIT=200000

# Semantic cache (migration 003). A hit needs the same tenant, role signature and content words; the
# cosine threshold is a second filter below the word check (EVAL_RESULTS.md, Phase 4 finding).
CACHE_ENABLED=true
# Tuned by the Phase 4 sweep; 0.95 is the spec's starting point until then.
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=24
# Temporal / entity-specific questions bypass the cache. JSON list of case-insensitive regexes; leave
# unset for the defaults in gateway/config.py (today, now, current, latest, as of, to date,
# this/last/next week|month|quarter|year, "for client <name>", ...).
# CACHE_BYPASS_PATTERNS=["\\btoday\\b"]

# --- Tests ---
# Database the pytest suite drops and recreates on the same Postgres server.
TEST_POSTGRES_DB=gateway_test
