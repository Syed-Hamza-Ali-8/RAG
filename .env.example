# Copy to .env and fill in. .env is gitignored; never commit secrets.

# --- Postgres (used by docker compose AND the app) ---
POSTGRES_USER=gateway
# Any strong local password.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gateway
# Host the app connects to; localhost when running the app on the WSL host.
POSTGRES_HOST=localhost
# Host port published by docker compose (container port is always 5432).
POSTGRES_HOST_PORT=5432

# --- Redis (ARQ background jobs, used from Phase 5) ---
# Host port published by docker compose: 6380, NOT the Redis default 6379, because another
# local project already binds 6379 on the dev machine. Clients connect to localhost:6380.
REDIS_HOST_PORT=6380

# --- Embeddings (local, fastembed) ---
# Must output EMBEDDING_DIM-sized vectors matching chunks.embedding in migrations/001_init.sql;
# the app refuses to start on a mismatch.
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Where ONNX weights are cached. Keep it on the Linux filesystem (not /mnt/*) for speed.
EMBEDDING_CACHE_DIR=/home/YOUR_USER/.cache/gateway/fastembed
# Texts per embedding batch.
EMBEDDING_BATCH_SIZE=32

# --- Chunking (tokens, counted with the embedding model's tokenizer) ---
CHUNK_TARGET_TOKENS=384
# Hard max; must stay below the model's max sequence length (512 for bge-small).
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=64

# --- Retrieval ---
# Chunks passed to the LLM per query.
RETRIEVAL_TOP_K=6

# --- LLM ---
# Which tier serves queries: small | large | local. Explicit choice; never switched at runtime.
LLM_TIER=small
# Phase 1: both small and large are Groq models (CLAUDE.md correction Q).
LLM_SMALL_BASE_URL=https://api.groq.com/openai/v1
LLM_SMALL_API_KEY=
# Filled by `uv run python scripts/resolve_models.py --small <id>`; never hand-typed.
LLM_SMALL_MODEL_ID=
LLM_LARGE_BASE_URL=https://api.groq.com/openai/v1
LLM_LARGE_API_KEY=
# Filled by `uv run python scripts/resolve_models.py --large <id>`.
LLM_LARGE_MODEL_ID=
# Optional local Ollama tier (LLM_TIER=local). Ollama ignores the key but the SDK needs one.
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL_ID=
# Per-request timeout, seconds.
LLM_TIMEOUT_S=60
# Attempts on 429/5xx/timeout before RateLimitExhausted / LLMUnavailable.
LLM_MAX_ATTEMPTS=5
# Exponential backoff base and cap, seconds (jittered).
LLM_BACKOFF_BASE_S=1.0
LLM_BACKOFF_MAX_S=30.0
LLM_MAX_COMPLETION_TOKENS=700
LLM_TEMPERATURE=0.0

# --- Eval / benchmarks ---
# Pause between requests in eval and latency runs, to stay under free-tier rate limits.
# 30000: measured clean twice (0 retries in 20) with ~2.3k-token prompts against Groq's 8,000
# tokens-per-minute limit. 20000 (3 requests/min) sits at that limit: it ran clean once and
# stalled once on repeated 429s.
EVAL_REQUEST_DELAY_MS=30000

# --- Tests ---
# Database the pytest suite drops and recreates on the same Postgres server.
TEST_POSTGRES_DB=gateway_test
