{"id": "b001", "category": "admin_non_admin", "as": "acme/intern@acme.example", "method": "GET", "path": "/v1/admin/users", "body": null, "expected_status": 403, "note": "lowest-privilege user lists users"}
{"id": "b002", "category": "admin_non_admin", "as": "acme/hr@acme.example", "method": "POST", "path": "/v1/admin/users", "body": {"email": "planted@acme.example", "roles": ["employee", "admin"], "clearance": 3}, "expected_status": 403, "not_created": ["planted@acme.example"], "note": "HR is not admin: cannot create an admin account"}
{"id": "b003", "category": "admin_non_admin", "as": "acme/legal@acme.example", "method": "PATCH", "path": "/v1/admin/users/{self}", "body": {"roles": ["employee", "legal", "admin"]}, "expected_status": 403, "unchanged": ["acme/legal@acme.example"], "note": "self-escalation; clearance 3 is not admin"}
{"id": "b004", "category": "admin_non_admin", "as": "acme/finance@acme.example", "method": "DELETE", "path": "/v1/admin/users/{user:acme/engineer@acme.example}", "body": null, "expected_status": 403, "unchanged": ["acme/engineer@acme.example"], "note": "non-admin deletes a colleague"}
{"id": "b005", "category": "admin_non_admin", "as": "acme/employee@acme.example", "method": "GET", "path": "/v1/admin/tenant", "body": null, "expected_status": 403, "note": "non-admin reads tenant settings"}
{"id": "b006", "category": "admin_non_admin", "as": "acme/contracts-manager@acme.example", "method": "PATCH", "path": "/v1/admin/tenant", "body": {"name": "Pwned"}, "expected_status": 403, "unchanged_tenants": ["acme"], "note": "multi-role, clearance 3, still not admin"}
{"id": "b007", "category": "admin_non_admin", "as": null, "method": "GET", "path": "/v1/admin/users", "body": null, "expected_status": 401, "note": "no token at all"}
{"id": "b008", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "GET", "path": "/v1/admin/users/{user:globex/hr@globex.example}", "body": null, "expected_status": 404, "same_as_missing": true, "note": "read another tenant's user by id; indistinguishable from a non-existent id"}
{"id": "b009", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "PATCH", "path": "/v1/admin/users/{user:globex/intern@globex.example}", "body": {"roles": ["employee", "admin"], "clearance": 3}, "expected_status": 404, "same_as_missing": true, "unchanged": ["globex/intern@globex.example"], "note": "escalate another tenant's user"}
{"id": "b010", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "DELETE", "path": "/v1/admin/users/{user:globex/legal@globex.example}", "body": null, "expected_status": 404, "same_as_missing": true, "unchanged": ["globex/legal@globex.example"], "note": "delete another tenant's user"}
{"id": "b011", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "GET", "path": "/v1/admin/users", "body": null, "expected_status": 200, "absent_strings": ["globex"], "note": "the user list holds the caller's tenant only"}
{"id": "b012", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "POST", "path": "/v1/admin/users", "body": {"tenant": "globex", "email": "planted@globex.example", "roles": ["employee", "admin"], "clearance": 3}, "expected_status": 422, "not_created": ["planted@globex.example"], "note": "body names another tenant; never accepted"}
{"id": "b013", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "POST", "path": "/v1/admin/users", "body": {"tenant_id": "{tenant:globex}", "email": "planted2@globex.example", "roles": ["employee"], "clearance": 0}, "expected_status": 422, "not_created": ["planted2@globex.example"], "note": "body carries another tenant's id"}
{"id": "b014", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "PATCH", "path": "/v1/admin/users/{user:acme/intern@acme.example}", "body": {"tenant_id": "{tenant:globex}"}, "expected_status": 422, "unchanged": ["acme/intern@acme.example"], "note": "move an own-tenant user into another tenant"}
{"id": "b015", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "PATCH", "path": "/v1/admin/tenant", "body": {"id": "{tenant:globex}", "name": "Pwned"}, "expected_status": 422, "unchanged_tenants": ["acme", "globex"], "note": "retarget the tenant update by body id"}
{"id": "b016", "category": "admin_cross_tenant", "as": "acme/admin@acme.example", "method": "GET", "path": "/v1/admin/tenant", "body": null, "expected_status": 200, "absent_strings": ["globex"], "note": "tenant settings are the caller's tenant only"}
{"id": "b017", "category": "admin_cross_tenant", "as": "globex/admin@globex.example", "method": "PATCH", "path": "/v1/admin/users/{user:acme/hr@acme.example}", "body": {"clearance": 0}, "expected_status": 404, "same_as_missing": true, "unchanged": ["acme/hr@acme.example"], "note": "symmetry: the other tenant's admin, the other direction"}
{"id": "b018", "category": "admin_stale", "as": "acme/admin@acme.example", "method": "GET", "path": "/v1/admin/users", "body": null, "expected_status": 403, "setup": {"revoke_roles": ["admin"]}, "note": "token issued while admin; admin role then removed in the database"}
{"id": "b019", "category": "admin_stale", "as": "acme/admin@acme.example", "method": "GET", "path": "/v1/admin/users", "body": null, "expected_status": 401, "setup": {"delete_user": true}, "note": "token for an admin account that has since been deleted"}
